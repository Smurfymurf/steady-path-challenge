# Copy to .env locally for `netlify dev`, or set in Netlify:
# Site settings → Environment variables → Add a variable
# (Apply to: All scopes / Production + Deploy previews + Branch deploys)

# MaxBounty Affiliate API (server-side only — never expose to the browser)
MAXBOUNTY_EMAIL=you@example.com
MAXBOUNTY_PASSWORD=your_maxbounty_password

# Optional tracking sub-ID on generated links
MAXBOUNTY_SUB1=finger-challenge

# Password for /admin offer dashboard (gate for assigning campaigns to the wheel)
ADMIN_PASSWORD=change-me
